<Page navigatingTo="onNavigatingTo" xmlns="http://schemas.nativescript.org/tns.xsd">

    <ActionBar title="Deliveries" flat="true" backgroundColor="#FFFFFF">
        <ActionBar.titleView>
            <Label text="Deliveries" fontSize="20" fontWeight="bold" color="#1A1A1A" />
        </ActionBar.titleView>
    </ActionBar>

    <GridLayout rows="*">

        <!-- Loading state -->
        <StackLayout row="0" verticalAlignment="middle" horizontalAlignment="center"
                     visibility="{{ isLoading ? 'visible' : 'collapsed' }}">
            <ActivityIndicator busy="true" color="#4CAF50" width="48" height="48" />
            <Label text="Loading deliveries..." class="subtitle" marginTop="12" />
        </StackLayout>

        <!-- Error state -->
        <StackLayout row="0" verticalAlignment="middle" horizontalAlignment="center"
                     visibility="{{ hasError ? 'visible' : 'collapsed' }}" padding="32">
            <Label text="⚠️" fontSize="48" textAlignment="center" />
            <Label text="{{ errorMessage }}" class="subtitle" textWrap="true"
                   textAlignment="center" marginTop="8" marginBottom="16" />
            <Button text="Retry" tap="{{ onRetryTap }}" class="btn-primary"
                    width="160" />
        </StackLayout>

        <!-- Empty state -->
        <StackLayout row="0" verticalAlignment="middle" horizontalAlignment="center"
                     visibility="{{ isEmpty ? 'visible' : 'collapsed' }}" padding="32">
            <Label text="📦" fontSize="64" textAlignment="center" />
            <Label text="No deliveries registered" class="title"
                   textAlignment="center" marginTop="16" marginBottom="8" />
            <Label text="Tap the + button to create your first delivery."
                   class="subtitle" textWrap="true" textAlignment="center" />
        </StackLayout>

        <!-- Deliveries list -->
        <ListView row="0" items="{{ deliveries }}" itemTap="{{ onDeliveryTap }}"
                  separatorColor="transparent"
                  visibility="{{ !isLoading &amp;&amp; !hasError &amp;&amp; !isEmpty ? 'visible' : 'collapsed' }}">
            <ListView.itemTemplate>
                <GridLayout rows="auto" columns="*" margin="10 16 0 16"
                            backgroundColor="#FFFFFF" borderRadius="16"
                            borderWidth="1" borderColor="#EEEEEE" padding="0"
                            androidElevation="3">

                    <StackLayout col="0" padding="0">

                        <!-- Header: ID + Status badge -->
                        <GridLayout columns="*, auto" padding="14 14 10 14">
                            <StackLayout col="0" orientation="horizontal">
                                <Label text="📦 " fontSize="14" verticalAlignment="middle" />
                                <Label text="Entrega #" fontSize="12" color="#9E9E9E"
                                       verticalAlignment="middle" />
                                <Label text="{{ id }}" fontSize="12" fontWeight="bold"
                                       color="#9E9E9E" verticalAlignment="middle" />
                            </StackLayout>
                            <StackLayout col="1" backgroundColor="{{ statusColor }}"
                                         borderRadius="20" padding="4 12"
                                         verticalAlignment="center">
                                <Label text="{{ statusLabel }}" fontSize="11"
                                       fontWeight="bold" color="{{ statusTextColor }}"
                                       textAlignment="center" />
                            </StackLayout>
                        </GridLayout>

                        <!-- Divider -->
                        <StackLayout height="1" backgroundColor="#F5F5F5" marginBottom="10" />

                        <!-- Participantes -->
                        <StackLayout padding="0 14 0 14" marginBottom="10">

                            <!-- Label sección -->
                            <Label text="PARTICIPANTES" fontSize="10" fontWeight="bold"
                                   color="#BDBDBD" letterSpacing="1" marginBottom="8" />

                            <!-- Cliente row -->
                            <GridLayout columns="auto, *" marginBottom="8">
                                <StackLayout col="0" width="36" height="36" borderRadius="18"
                                             backgroundColor="#E8F5E9"
                                             verticalAlignment="middle"
                                             horizontalAlignment="center"
                                             margin="0 10 0 0">
                                    <Label text="👤" fontSize="16" textAlignment="center"
                                           verticalAlignment="middle" />
                                </StackLayout>
                                <StackLayout col="1" verticalAlignment="middle">
                                    <Label text="CLIENTE" fontSize="9" fontWeight="bold"
                                           color="#BDBDBD" letterSpacing="0.5" />
                                    <Label text="{{ client }}" fontSize="13" fontWeight="bold"
                                           color="#212121" />
                                </StackLayout>
                            </GridLayout>

                            <!-- Repartidor row -->
                            <GridLayout columns="auto, *">
                                <StackLayout col="0" width="36" height="36" borderRadius="18"
                                             backgroundColor="#FFF8E1"
                                             verticalAlignment="middle"
                                             horizontalAlignment="center"
                                             margin="0 10 0 0">
                                    <Label text="🚚" fontSize="16" textAlignment="center"
                                           verticalAlignment="middle" />
                                </StackLayout>
                                <StackLayout col="1" verticalAlignment="middle">
                                    <Label text="REPARTIDOR" fontSize="9" fontWeight="bold"
                                           color="#BDBDBD" letterSpacing="0.5" />
                                    <Label text="{{ driver }}" fontSize="13" fontWeight="bold"
                                           color="#212121" />
                                </StackLayout>
                            </GridLayout>

                        </StackLayout>

                        <!-- Divider -->
                        <StackLayout height="1" backgroundColor="#F5F5F5" marginBottom="10" />

                        <!-- Ruta de entrega -->
                        <StackLayout padding="0 14 14 14">

                            <!-- Label sección -->
                            <Label text="RUTA DE ENTREGA" fontSize="10" fontWeight="bold"
                                   color="#BDBDBD" letterSpacing="1" marginBottom="10" />

                            <!-- Origen -->
                            <GridLayout columns="auto, *" marginBottom="4">
                                <StackLayout col="0" width="28" height="28" borderRadius="14"
                                             backgroundColor="#E8F5E9"
                                             verticalAlignment="middle"
                                             horizontalAlignment="center"
                                             margin="0 10 0 0">
                                    <Label text="📍" fontSize="13" textAlignment="center"
                                           verticalAlignment="middle" />
                                </StackLayout>
                                <StackLayout col="1" verticalAlignment="middle">
                                    <Label text="ORIGEN" fontSize="9" color="#BDBDBD"
                                           letterSpacing="0.5" fontWeight="bold" />
                                    <Label text="{{ origin }}" fontSize="12" color="#424242"
                                           textWrap="true" />
                                </StackLayout>
                            </GridLayout>

                            <!-- Arrow connector -->
                            <StackLayout margin="0 0 0 9" marginBottom="4">
                                <Label text="↓" fontSize="16" color="#4CAF50"
                                       textAlignment="left" margin="0 0 0 5" />
                            </StackLayout>

                            <!-- Destino -->
                            <GridLayout columns="auto, *">
                                <StackLayout col="0" width="28" height="28" borderRadius="14"
                                             backgroundColor="#FCE4EC"
                                             verticalAlignment="middle"
                                             horizontalAlignment="center"
                                             margin="0 10 0 0">
                                    <Label text="🎯" fontSize="13" textAlignment="center"
                                           verticalAlignment="middle" />
                                </StackLayout>
                                <StackLayout col="1" verticalAlignment="middle">
                                    <Label text="DESTINO" fontSize="9" color="#BDBDBD"
                                           letterSpacing="0.5" fontWeight="bold" />
                                    <Label text="{{ destination }}" fontSize="12" color="#424242"
                                           textWrap="true" />
                                </StackLayout>
                            </GridLayout>

                        </StackLayout>

                    </StackLayout>

                </GridLayout>
            </ListView.itemTemplate>
        </ListView>

        <!-- FAB -->
        <StackLayout row="0" verticalAlignment="bottom" horizontalAlignment="right"
                     margin="0 24 24 0">
            <Button text="+" tap="{{ onAddTap }}"
                    width="56" height="56" borderRadius="28"
                    fontSize="28" fontWeight="bold"
                    color="#FFFFFF" backgroundColor="#4CAF50" />
        </StackLayout>

    </GridLayout>
</Page>