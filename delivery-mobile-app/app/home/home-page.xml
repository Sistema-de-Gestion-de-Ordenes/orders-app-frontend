<Page navigatingTo="onNavigatingTo" xmlns="http://schemas.nativescript.org/tns.xsd">

    <ActionBar flat="true" backgroundColor="#FFFFFF">
        <ActionBar.titleView>
            <GridLayout columns="auto, *, auto" padding="0 14">
                <StackLayout col="0" width="36" height="36" borderRadius="8"
                             backgroundColor="#1A1A1A"
                             verticalAlignment="middle" horizontalAlignment="center">
                    <Label text="⚡" fontSize="13" textAlignment="right"
                           verticalAlignment="middle"/>
                </StackLayout>
                <Label col="1" text="Entregas" fontSize="18" fontWeight="bold"
                       color="#1A1A1A" textAlignment="center" verticalAlignment="middle" />
                <Label col="2" text="⊽" fontSize="20" color="#1A1A1A"
                       verticalAlignment="middle" horizontalAlignment="right" />
            </GridLayout>
        </ActionBar.titleView>
    </ActionBar>

    <GridLayout rows="*, auto">

        <!-- ── CONTENT ROW ── -->
        <!-- rows: offline banner | filter chips | contenido -->
        <GridLayout row="0" rows="auto, auto, *">

            <!-- Offline banner -->
            <GridLayout row="0" columns="auto, *" class="offline-banner"
                        visibility="{{ isOffline ? 'visible' : 'collapsed' }}">
                <Label col="0" text="⊘" fontSize="14" color="#9E9E9E"
                       verticalAlignment="middle" marginRight="8" />
                <Label col="1" text="Modo offline — mostrando datos guardados localmente"
                       fontSize="12" color="#757575" verticalAlignment="middle" textWrap="true" />
            </GridLayout>

            <!-- ── FILTER CHIPS ──
                 Cada chip usa su propio tap handler y un booleano dedicado para
                 el color activo. NativeScript no evalúa comparaciones (===) en
                 expresiones de binding XML, así que NO usar activeFilter === 'x'.
            -->
            <ScrollView row="1" orientation="horizontal" scrollBarIndicatorVisible="false"
                        padding="10 12 6 12" backgroundColor="#FFFFFF">
                <StackLayout orientation="horizontal">

                    <Label text="Todas" tap="{{ onFilterAll }}"
                           margin="0 4" padding="6 16" borderRadius="20"
                           fontSize="12" fontWeight="bold"
                           backgroundColor="{{ filterAll      ? '#4CAF50' : '#F0F0F0' }}"
                           color=          "{{ filterAll      ? '#FFFFFF' : '#616161' }}" />

                    <Label text="Pendiente" tap="{{ onFilterPending }}"
                           margin="0 4" padding="6 16" borderRadius="20"
                           fontSize="12" fontWeight="bold"
                           backgroundColor="{{ filterPending   ? '#616161' : '#F0F0F0' }}"
                           color=          "{{ filterPending   ? '#FFFFFF' : '#616161' }}" />

                    <Label text="En tránsito" tap="{{ onFilterInTransit }}"
                           margin="0 4" padding="6 16" borderRadius="20"
                           fontSize="12" fontWeight="bold"
                           backgroundColor="{{ filterInTransit ? '#1565C0' : '#F0F0F0' }}"
                           color=          "{{ filterInTransit ? '#FFFFFF' : '#616161' }}" />

                    <Label text="Entregado" tap="{{ onFilterDelivered }}"
                           margin="0 4" padding="6 16" borderRadius="20"
                           fontSize="12" fontWeight="bold"
                           backgroundColor="{{ filterDelivered ? '#2E7D32' : '#F0F0F0' }}"
                           color=          "{{ filterDelivered ? '#FFFFFF' : '#616161' }}" />

                    <Label text="Cancelado" tap="{{ onFilterCanceled }}"
                           margin="0 4" padding="6 16" borderRadius="20"
                           fontSize="12" fontWeight="bold"
                           backgroundColor="{{ filterCanceled  ? '#C62828' : '#F0F0F0' }}"
                           color=          "{{ filterCanceled  ? '#FFFFFF' : '#616161' }}" />

                </StackLayout>
            </ScrollView>

            <!-- Loading state -->
            <StackLayout row="2" verticalAlignment="middle" horizontalAlignment="center"
                         visibility="{{ isLoading ? 'visible' : 'collapsed' }}">
                <ActivityIndicator busy="true" color="#4CAF50" width="48" height="48" />
                <Label text="Cargando entregas..." class="subtitle" marginTop="12" />
            </StackLayout>

            <!-- Error state -->
            <StackLayout row="2" verticalAlignment="middle" horizontalAlignment="center"
                         visibility="{{ hasError ? 'visible' : 'collapsed' }}" padding="32">
                <Label text="⚠️" fontSize="48" textAlignment="center" />
                <Label text="{{ errorMessage }}" class="subtitle" textWrap="true"
                       textAlignment="center" marginTop="8" marginBottom="16" />
                <Button text="Reintentar" tap="{{ onRetryTap }}" class="btn-primary"
                        width="160" />
            </StackLayout>

            <!-- Empty state -->
            <StackLayout row="2" verticalAlignment="middle" horizontalAlignment="center"
                         visibility="{{ isEmpty ? 'visible' : 'collapsed' }}" padding="32">
                <Label text="📦" fontSize="64" textAlignment="center" />
                <Label text="No hay entregas registradas" class="title"
                       textAlignment="center" marginTop="16" marginBottom="8" />
                <Label text="Toca el botón + para crear tu primera entrega."
                       class="subtitle" textWrap="true" textAlignment="center" />
            </StackLayout>

            <!-- Deliveries list -->
            <ListView row="2" items="{{ deliveries }}"
                      separatorColor="transparent"
                      visibility="{{ !isLoading &amp;&amp; !hasError &amp;&amp; !isEmpty ? 'visible' : 'collapsed' }}">
                <ListView.itemTemplate>
                    <GridLayout rows="auto" columns="*" margin="8 16 0 16"
                                backgroundColor="#FFFFFF" borderRadius="16"
                                borderWidth="1" borderColor="#EEEEEE" padding="0"
                                androidElevation="2"
                                tap="{{ onDetailTap }}">
                        <StackLayout col="0" padding="0">

                            <!-- Header: Entrega # + badge -->
                            <GridLayout columns="auto, *, auto" padding="14 14 10 14">
                                <StackLayout col="0" width="32" height="32" borderRadius="8"
                                             backgroundColor="#F0FBF4"
                                             verticalAlignment="middle"
                                             horizontalAlignment="center"
                                             margin="0 10 0 0">
                                    <Label text="📦" fontSize="16" textAlignment="center"
                                           verticalAlignment="middle" />
                                </StackLayout>
                                <Label col="1" text="{{ 'Entrega #' + id }}" fontSize="16"
                                       fontWeight="bold" color="#1A1A1A"
                                       verticalAlignment="middle" />
                                <StackLayout col="2" backgroundColor="{{ statusColor }}"
                                             borderRadius="20" padding="5 14"
                                             verticalAlignment="center">
                                    <Label text="{{ statusLabel }}" fontSize="12"
                                           fontWeight="bold" color="{{ statusTextColor }}"
                                           textAlignment="center" />
                                </StackLayout>
                            </GridLayout>

                            <!-- Divider -->
                            <StackLayout height="1" backgroundColor="#F0F0F0" margin="0 14" />

                            <!-- Participantes -->
                            <GridLayout columns="*, 1, *" padding="12 14 12 14">
                                <StackLayout col="0" orientation="horizontal">
                                    <StackLayout width="40" height="40" borderRadius="20"
                                                 backgroundColor="#E0E0E0"
                                                 verticalAlignment="middle"
                                                 horizontalAlignment="center"
                                                 margin="0 10 0 0">
                                        <Label text="👤" fontSize="18" textAlignment="center"
                                               verticalAlignment="middle" />
                                    </StackLayout>
                                    <StackLayout verticalAlignment="middle">
                                        <Label text="CLIENTE" fontSize="9" color="#BDBDBD"
                                               fontWeight="bold" letterSpacing="0.5" />
                                        <Label text="{{ client }}" fontSize="13"
                                               fontWeight="bold" color="#1A1A1A"
                                               textWrap="true" width="90" />
                                    </StackLayout>
                                </StackLayout>
                                <StackLayout col="1" width="1" backgroundColor="#EEEEEE" margin="4 0" />
                                <StackLayout col="2" orientation="horizontal" margin="0 0 0 12">
                                    <StackLayout width="40" height="40" borderRadius="20"
                                                 backgroundColor="#E0E0E0"
                                                 verticalAlignment="middle"
                                                 horizontalAlignment="center"
                                                 margin="0 10 0 0">
                                        <Label text="🚚" fontSize="18" textAlignment="center"
                                               verticalAlignment="middle" />
                                    </StackLayout>
                                    <StackLayout verticalAlignment="middle">
                                        <Label text="REPARTIDOR" fontSize="9" color="#BDBDBD"
                                               fontWeight="bold" letterSpacing="0.5" />
                                        <Label text="{{ driver }}" fontSize="13"
                                               fontWeight="bold" color="#1A1A1A"
                                               textWrap="true" width="90" />
                                    </StackLayout>
                                </StackLayout>
                            </GridLayout>

                            <!-- Divider -->
                            <StackLayout height="1" backgroundColor="#F0F0F0" margin="0 14" />

                            <!-- Ruta -->
                            <StackLayout padding="10 14 14 14">
                                <GridLayout columns="auto, *" marginBottom="6">
                                    <Label col="0" text="⊙" fontSize="16" color="#4CAF50"
                                           verticalAlignment="middle" margin="0 8 0 0" />
                                    <Label col="1" text="{{ origin }}" fontSize="12"
                                           color="#424242" verticalAlignment="middle" textWrap="true" />
                                </GridLayout>
                                <GridLayout columns="auto, auto, auto, *" marginBottom="6"
                                            verticalAlignment="middle">
                                    <StackLayout col="0" width="10" height="10" borderRadius="5"
                                                 backgroundColor="#4CAF50" margin="0 0 0 6" />
                                    <StackLayout col="1" height="2" width="40" backgroundColor="#4CAF50" />
                                    <StackLayout col="2" width="10" height="10" borderRadius="5"
                                                 backgroundColor="#4CAF50" />
                                    <StackLayout col="3" height="2" backgroundColor="#E0E0E0" />
                                </GridLayout>
                                <GridLayout columns="auto, *">
                                    <Label col="0" text="⊙" fontSize="16" color="#4CAF50"
                                           verticalAlignment="middle" margin="0 8 0 0" />
                                    <Label col="1" text="{{ destination }}" fontSize="12"
                                           color="#424242" verticalAlignment="middle" textWrap="true" />
                                </GridLayout>
                            </StackLayout>

                            <!-- Botón editar (solo admins) -->
                            <StackLayout padding="0 14 14 14"
                                         visibility="{{ isAdmin ? 'visible' : 'collapsed' }}">
                                <StackLayout height="1" backgroundColor="#F0F0F0" marginBottom="12" />
                                <Button text="✏  Editar entrega" tap="{{ onEditTap }}"
                                        backgroundColor="#4CAF50" color="#FFFFFF"
                                        borderRadius="8" fontSize="13" fontWeight="bold"
                                        padding="10 0" />
                            </StackLayout>

                        </StackLayout>
                    </GridLayout>
                </ListView.itemTemplate>
            </ListView>

            <!-- FAB -->
            <StackLayout row="2" verticalAlignment="bottom" horizontalAlignment="right"
                         margin="0 24 24 0">
                <Button text="+" tap="{{ onAddTap }}"
                        width="56" height="56" borderRadius="28"
                        fontSize="28" fontWeight="bold"
                        color="#FFFFFF" backgroundColor="#4CAF50" />
            </StackLayout>

        </GridLayout>

        <!-- ── BOTTOM NAV ── -->
        <GridLayout row="1" columns="*, *, *, *" class="bottom-nav">

            <StackLayout col="0" class="nav-item" tap="onGoToEntregas">
                <StackLayout width="18" height="16" borderRadius="2"
                             borderWidth="1.5" borderColor="#4CAF50"
                             backgroundColor="transparent"
                             horizontalAlignment="center" marginBottom="4" />
                <Label text="Entregas" class="nav-label-active" />
            </StackLayout>

            <StackLayout col="1" class="nav-item" tap="onGoToClientes">
                <StackLayout width="24" height="18" horizontalAlignment="center" marginBottom="4">
                    <StackLayout width="8" height="8" borderRadius="4"
                                 borderWidth="1.5" borderColor="#9E9E9E"
                                 backgroundColor="transparent" horizontalAlignment="center" />
                    <StackLayout width="14" height="6"
                                 borderTopLeftRadius="7" borderTopRightRadius="7"
                                 borderWidth="1.5" borderBottomWidth="0" borderColor="#9E9E9E"
                                 backgroundColor="transparent"
                                 horizontalAlignment="center" marginTop="1" />
                </StackLayout>
                <Label text="Clientes" class="nav-label" />
            </StackLayout>

            <StackLayout col="2" class="nav-item" tap="onGoToRepartidores">
                <StackLayout width="24" height="20" horizontalAlignment="center" marginBottom="4">
                    <StackLayout width="20" height="12" borderRadius="2"
                                 borderWidth="1.5" borderColor="#9E9E9E"
                                 backgroundColor="transparent" horizontalAlignment="center" />
                    <GridLayout columns="*, *" width="16" horizontalAlignment="center" marginTop="-1">
                        <StackLayout col="0" width="5" height="5" borderRadius="3"
                                     borderWidth="1.5" borderColor="#9E9E9E"
                                     backgroundColor="transparent" horizontalAlignment="center" />
                        <StackLayout col="1" width="5" height="5" borderRadius="3"
                                     borderWidth="1.5" borderColor="#9E9E9E"
                                     backgroundColor="transparent" horizontalAlignment="center" />
                    </GridLayout>
                </StackLayout>
                <Label text="Repartidores" class="nav-label" />
            </StackLayout>

            <StackLayout col="3" class="nav-item" tap="onGoToPerfil">
                <StackLayout width="24" height="18" horizontalAlignment="center" marginBottom="4">
                    <StackLayout width="8" height="8" borderRadius="4"
                                 borderWidth="1.5" borderColor="#9E9E9E"
                                 backgroundColor="transparent" horizontalAlignment="center" />
                    <StackLayout width="14" height="6"
                                 borderTopLeftRadius="7" borderTopRightRadius="7"
                                 borderWidth="1.5" borderBottomWidth="0" borderColor="#9E9E9E"
                                 backgroundColor="transparent"
                                 horizontalAlignment="center" marginTop="1" />
                </StackLayout>
                <Label text="Perfil" class="nav-label" />
            </StackLayout>

        </GridLayout>

    </GridLayout>
</Page>