<Page navigatingTo="onNavigatingTo" actionBarHidden="true"
      xmlns="http://schemas.nativescript.org/tns.xsd">

    <GridLayout rows="auto, auto, *, auto">

        <!-- Header (same as create client) -->
        <GridLayout row="0" columns="40, *, 40" backgroundColor="#FFFFFF"
                    paddingTop="28" paddingBottom="12" paddingLeft="16" paddingRight="16">
            <Label col="0" text="‹" fontSize="28" color="#1A1A1A"
                   verticalAlignment="middle" tap="{{ onBack }}" />
            <Label col="1" text="{{ pageTitle }}" fontSize="18" fontWeight="bold"
                   color="#1A1A1A" textAlignment="center" verticalAlignment="middle" />
            <Label col="2" text="" />
        </GridLayout>

        <!-- Success card (same as create client) -->
        <StackLayout row="1" class="success-card"
                     visibility="{{ showSuccess ? 'visible' : 'collapsed' }}">
            <GridLayout columns="auto, *, auto">
                <StackLayout col="0" width="28" height="28" borderRadius="14"
                             backgroundColor="#4CAF50" verticalAlignment="middle" marginRight="12">
                    <Label text="✓" color="#FFFFFF" fontSize="14" fontWeight="bold"
                           textAlignment="center" verticalAlignment="middle" />
                </StackLayout>
                <Label col="1" text="Entrega actualizada correctamente" fontSize="14"
                       color="#1A1A1A" verticalAlignment="middle" />
                <Label col="2" text="⊕" fontSize="20" color="#9E9E9E"
                       verticalAlignment="middle" marginLeft="8" tap="{{ onDismissSuccess }}" />
            </GridLayout>
        </StackLayout>

        <!-- Bottom navigation bar (Entregas active) -->
        <GridLayout row="3" columns="*, *, *, *" class="bottom-nav">

            <!-- Entregas (active) -->
            <StackLayout col="0" class="nav-item">
                <StackLayout width="18" height="16" borderRadius="2"
                             borderWidth="1.5" borderColor="#4CAF50"
                             backgroundColor="transparent"
                             horizontalAlignment="center" marginBottom="4" />
                <Label text="Entregas" class="nav-label-active" />
            </StackLayout>

            <!-- Clients -->
            <StackLayout col="1" class="nav-item">
                <StackLayout width="24" height="18" horizontalAlignment="center" marginBottom="4">
                    <StackLayout width="8" height="8" borderRadius="4"
                                 borderWidth="1.5" borderColor="#9E9E9E"
                                 backgroundColor="transparent" horizontalAlignment="center" />
                    <StackLayout width="14" height="6"
                                 borderTopLeftRadius="7" borderTopRightRadius="7"
                                 borderWidth="1.5" borderBottomWidth="0" borderColor="#9E9E9E"
                                 backgroundColor="transparent"
                                 horizontalAlignment="center" marginTop="1" />
                </StackLayout>
                <Label text="Clientes" class="nav-label" />
            </StackLayout>

            <!-- Drivers -->
            <StackLayout col="2" class="nav-item">
                <StackLayout width="24" height="20" horizontalAlignment="center" marginBottom="4">
                    <StackLayout width="20" height="12" borderRadius="2"
                                 borderWidth="1.5" borderColor="#9E9E9E"
                                 backgroundColor="transparent" horizontalAlignment="center" />
                    <GridLayout columns="*, *" width="16" horizontalAlignment="center" marginTop="-1">
                        <StackLayout col="0" width="5" height="5" borderRadius="3"
                                     borderWidth="1.5" borderColor="#9E9E9E"
                                     backgroundColor="transparent" horizontalAlignment="center" />
                        <StackLayout col="1" width="5" height="5" borderRadius="3"
                                     borderWidth="1.5" borderColor="#9E9E9E"
                                     backgroundColor="transparent" horizontalAlignment="center" />
                    </GridLayout>
                </StackLayout>
                <Label text="Repartidores" class="nav-label" />
            </StackLayout>

            <!-- Profile -->
            <StackLayout col="3" class="nav-item">
                <StackLayout width="24" height="18" horizontalAlignment="center" marginBottom="4">
                    <StackLayout width="8" height="8" borderRadius="4"
                                 borderWidth="1.5" borderColor="#9E9E9E"
                                 backgroundColor="transparent" horizontalAlignment="center" />
                    <StackLayout width="14" height="6"
                                 borderTopLeftRadius="7" borderTopRightRadius="7"
                                 borderWidth="1.5" borderBottomWidth="0" borderColor="#9E9E9E"
                                 backgroundColor="transparent"
                                 horizontalAlignment="center" marginTop="1" />
                </StackLayout>
                <Label text="Perfil" class="nav-label" />
            </StackLayout>

        </GridLayout>

        <!-- Content -->
        <ScrollView row="2">
            <StackLayout class="page-container">

                <!-- State: loading data -->
                <StackLayout visibility="{{ isLoadingData ? 'visible' : 'collapsed' }}"
                             horizontalAlignment="center" marginTop="48">
                    <ActivityIndicator busy="true" color="#4CAF50"
                                       horizontalAlignment="center" />
                    <Label text="Cargando datos..." class="subtitle" marginTop="12" />
                </StackLayout>

                <!-- State: load error -->
                <StackLayout visibility="{{ hasLoadError ? 'visible' : 'collapsed' }}"
                             horizontalAlignment="center" marginTop="48">
                    <Label text="{{ loadError }}" class="error-label"
                           textWrap="true" marginBottom="16" />
                    <Button text="Reintentar" tap="{{ onRetry }}" class="btn-primary" />
                </StackLayout>

                <!-- Formulario -->
                <StackLayout visibility="{{ isFormVisible ? 'visible' : 'collapsed' }}">

                    <!-- Origin point -->
                    <Label text="Punto de origen" class="label-field" marginTop="8" />
                    <GridLayout columns="auto, *" class="input-field">
                        <StackLayout col="0" width="16" marginRight="12" verticalAlignment="middle">
                            <StackLayout width="10" height="10" borderRadius="5"
                                         borderWidth="1.5" borderColor="#BDBDBD"
                                         backgroundColor="transparent" horizontalAlignment="center" />
                            <StackLayout width="2" height="5" backgroundColor="#BDBDBD"
                                         horizontalAlignment="center" />
                        </StackLayout>
                        <TextField col="1" text="{{ origin }}" hint="Ej. San José, Cartago..."
                                   autocorrect="false" backgroundColor="transparent"
                                   borderWidth="0" padding="0" />
                    </GridLayout>

                    <!-- Origin - loading -->
                    <StackLayout visibility="{{ isLoadingOriginSuggestions ? 'visible' : 'collapsed' }}"
                                 backgroundColor="#FFFFFF" borderWidth="1" borderColor="#E0E0E0"
                                 borderRadius="10" padding="14" marginTop="-12" marginBottom="4">
                        <ActivityIndicator busy="true" color="#4CAF50" width="28" height="28"
                                           horizontalAlignment="center" />
                    </StackLayout>

                    <!-- Origin - offline -->
                    <StackLayout visibility="{{ showOriginOffline ? 'visible' : 'collapsed' }}"
                                 backgroundColor="#FFF8E1" borderWidth="1" borderColor="#FFE082"
                                 borderRadius="10" padding="12" marginTop="-12" marginBottom="4">
                        <Label text="Sin conexión. No se pueden mostrar sugerencias."
                               fontSize="12" color="#F57F17" textWrap="true" textAlignment="center" />
                    </StackLayout>

                    <!-- Origin - results -->
                    <ListView items="{{ originSuggestions }}" itemTap="{{ onOriginSuggestionTap }}"
                              height="{{ originListHeight }}"
                              visibility="{{ showOriginSuggestions ? 'visible' : 'collapsed' }}"
                              separatorColor="#F0F0F0" marginTop="-12" marginBottom="4">
                        <ListView.itemTemplate>
                            <Label text="{{ displayName }}" class="suggestion-item" textWrap="true" />
                        </ListView.itemTemplate>
                    </ListView>

                    <!-- Destination point -->
                    <Label text="Punto de destino" class="label-field" />
                    <GridLayout columns="auto, *" class="input-field">
                        <StackLayout col="0" width="16" marginRight="12" verticalAlignment="middle">
                            <StackLayout width="10" height="10" borderRadius="5"
                                         borderWidth="1.5" borderColor="#BDBDBD"
                                         backgroundColor="transparent" horizontalAlignment="center" />
                            <StackLayout width="2" height="5" backgroundColor="#BDBDBD"
                                         horizontalAlignment="center" />
                        </StackLayout>
                        <TextField col="1" text="{{ destination }}" hint="Ej. Alajuela, Heredia..."
                                   autocorrect="false" backgroundColor="transparent"
                                   borderWidth="0" padding="0" />
                    </GridLayout>

                    <!-- Destination - loading -->
                    <StackLayout visibility="{{ isLoadingDestinationSuggestions ? 'visible' : 'collapsed' }}"
                                 backgroundColor="#FFFFFF" borderWidth="1" borderColor="#E0E0E0"
                                 borderRadius="10" padding="14" marginTop="-12" marginBottom="4">
                        <ActivityIndicator busy="true" color="#4CAF50" width="28" height="28"
                                           horizontalAlignment="center" />
                    </StackLayout>

                    <!-- Destination - offline -->
                    <StackLayout visibility="{{ showDestinationOffline ? 'visible' : 'collapsed' }}"
                                 backgroundColor="#FFF8E1" borderWidth="1" borderColor="#FFE082"
                                 borderRadius="10" padding="12" marginTop="-12" marginBottom="4">
                        <Label text="Sin conexión. No se pueden mostrar sugerencias."
                               fontSize="12" color="#F57F17" textWrap="true" textAlignment="center" />
                    </StackLayout>

                    <!-- Destination - results -->
                    <ListView items="{{ destinationSuggestions }}" itemTap="{{ onDestinationSuggestionTap }}"
                              height="{{ destinationListHeight }}"
                              visibility="{{ showDestinationSuggestions ? 'visible' : 'collapsed' }}"
                              separatorColor="#F0F0F0" marginTop="-12" marginBottom="4">
                        <ListView.itemTemplate>
                            <Label text="{{ displayName }}" class="suggestion-item" textWrap="true" />
                        </ListView.itemTemplate>
                    </ListView>

                    <!-- Assigned driver -->
                    <Label text="Repartidor asignado" class="label-field" />

                    <!-- Current driver -->
                    <GridLayout columns="auto, *, auto" class="input-field" marginBottom="8">
                        <StackLayout col="0" width="16" marginRight="12" verticalAlignment="middle">
                            <StackLayout width="8" height="8" borderRadius="4"
                                         borderWidth="1.5" borderColor="#4CAF50"
                                         backgroundColor="transparent" horizontalAlignment="center" />
                            <StackLayout width="14" height="7"
                                         borderTopLeftRadius="7" borderTopRightRadius="7"
                                         borderWidth="1.5" borderBottomWidth="0" borderColor="#4CAF50"
                                         backgroundColor="transparent"
                                         horizontalAlignment="center" marginTop="1" />
                        </StackLayout>
                        <StackLayout col="1" verticalAlignment="middle">
                            <Label text="{{ currentDriverName }}" fontSize="14" color="#1A1A1A" fontWeight="bold" />
                            <Label text="{{ currentDriverPhone }}" fontSize="12" color="#757575" />
                        </StackLayout>
                        <Label col="2" text="Actual" fontSize="12" fontWeight="bold"
                               color="#4CAF50" verticalAlignment="middle" />
                    </GridLayout>

                    <!-- Selector: find another driver -->
                    <GridLayout columns="auto, *, auto" class="input-field"
                                tap="{{ onToggleDriverList }}">
                        <StackLayout col="0" width="16" marginRight="12" verticalAlignment="middle">
                            <StackLayout width="8" height="8" borderRadius="4"
                                         borderWidth="1.5" borderColor="#BDBDBD"
                                         backgroundColor="transparent" horizontalAlignment="center" />
                            <StackLayout width="14" height="7"
                                         borderTopLeftRadius="7" borderTopRightRadius="7"
                                         borderWidth="1.5" borderBottomWidth="0" borderColor="#BDBDBD"
                                         backgroundColor="transparent"
                                         horizontalAlignment="center" marginTop="1" />
                        </StackLayout>
                        <Label col="1" text="{{ selectedDriverLabel }}" fontSize="14"
                               color="#9E9E9E" verticalAlignment="middle" />
                        <Label col="2" text="{{ showDriverList ? '▲' : '▼' }}" fontSize="12"
                               color="#9E9E9E" verticalAlignment="middle" />
                    </GridLayout>

                    <!-- Driver list -->
                    <ListView items="{{ drivers }}" itemTap="{{ onDriverTap }}"
                              height="{{ driverListHeight }}"
                              visibility="{{ showDriverList ? 'visible' : 'collapsed' }}"
                              separatorColor="#F0F0F0" marginTop="-12" marginBottom="4"
                              backgroundColor="#FFFFFF">
                        <ListView.itemTemplate>
                            <GridLayout columns="auto, *" padding="12 16">
                                <StackLayout col="0" width="32" height="32" borderRadius="16"
                                             backgroundColor="#4CAF50" marginRight="12"
                                             horizontalAlignment="left" verticalAlignment="middle">
                                    <Label text="{{ initial }}" fontSize="14" fontWeight="bold"
                                           color="#FFFFFF" textAlignment="center"
                                           verticalAlignment="middle" />
                                </StackLayout>
                                <StackLayout col="1" verticalAlignment="middle">
                                    <Label text="{{ name }}" fontSize="14" fontWeight="bold" color="#1A1A1A" />
                                    <Label text="{{ vehicle }}" fontSize="12" color="#757575" />
                                </StackLayout>
                            </GridLayout>
                        </ListView.itemTemplate>
                    </ListView>

                    <!-- Error message -->
                    <Label text="{{ errorMessage }}" class="error-label"
                           visibility="{{ hasError ? 'visible' : 'collapsed' }}" textWrap="true" />

                    <!-- Saving spinner -->
                    <ActivityIndicator busy="{{ isLoading }}" color="#4CAF50"
                                       visibility="{{ isLoading ? 'visible' : 'collapsed' }}"
                                       horizontalAlignment="center" marginTop="8" />

                    <!-- Save button (same pattern as create client) -->
                    <Button text="{{ isLoading ? 'Guardando...' : 'Guardar cambios' }}"
                            tap="{{ onSave }}" isEnabled="{{ !isLoading }}"
                            class="btn-primary" marginTop="8" />

                    <StackLayout height="40" />

                </StackLayout>

            </StackLayout>
        </ScrollView>

    </GridLayout>

</Page>
